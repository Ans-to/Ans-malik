      "start_sample": 381448,
      "end_sample": 525832,
      "start_sec": 8.649614512471656,
      "end_sec": 11.923628117913832,
      "spoken_text": "and high-speed digital ledgers took its place."
    },
    {
      "clause_id": 4,
      "start_sample": 533770,
      "end_sample": 682250,
      "start_sec": 12.103628117913832,
      "end_sec": 15.470521541950113,
      "spoken_text": "Today, one currency still dominates the planet,"
    },
    {
      "clause_id": 5,
      "start_sample": 690188,
      "end_sample": 842252,
      "start_sec": 15.650521541950113,
      "end_sec": 19.098684807256237,
      "spoken_text": "powering eighty-eight percent of all global trade."
    }
